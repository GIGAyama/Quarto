{
  "name": "quarto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://GIGAyama.github.io/Quarto",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/build-sw.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "node --test",
    "check": "node tools/check-secrets.mjs && node scripts/check-project.mjs",
    "check:self": "node scripts/check-project.mjs --self-test",
    "measure": "node tools/measure.mjs",
    "measure:update": "node tools/measure-update.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "serve:dist": "node tools/serve-dist.mjs",
    "check:secrets": "node tools/check-secrets.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sweetalert2": "^11.26.25",
    "three": "^0.158.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "gh-pages": "^6.1.1",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
